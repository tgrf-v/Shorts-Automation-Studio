# Application Environment
APP_ENV=development
APP_NAME="Shorts Automation Studio"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=shorts_automation
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_dev@postgres:5432/shorts_automation

# Cache & Queue (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Google Gemini API (Primary)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional OpenAI provider
OPENAI_API_KEY=your_openai_api_key_here

# Script Generation (Milestone 4)
SCRIPT_PROVIDER=gemini
SCRIPT_MODEL=gemini-2.5-flash
SCRIPT_TARGET_WPM=150
SCRIPT_MAX_DURATION_RATIO=1.15
SCRIPT_MIN_DURATION_RATIO=0.85
SCRIPT_QUEUE_NAME=shorts:queue:script

# TTS & Narration Timeline (Milestone 5)
TTS_PROVIDER=google
TTS_MODEL=
TTS_VOICE=id-ID-Standard-A
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_QUEUE_NAME=shorts:queue:tts

# Visual Footage Search (Milestone 6)
FOOTAGE_SEARCH_PROVIDER=youtube
FOOTAGE_MAX_QUERIES_PER_SCENE=4
FOOTAGE_MAX_RESULTS_PER_QUERY=10
FOOTAGE_MAX_TOTAL_CANDIDATES=30
FOOTAGE_VISUAL_WEIGHT=0.60
FOOTAGE_CONTEXT_WEIGHT=0.25
FOOTAGE_METADATA_WEIGHT=0.15
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Media Storage & Upload
MEDIA_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=500

# Cloudflare R2 / S3 Object Storage (Production)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=shorts-automation-assets
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key

# Web / Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000

# Reference Video Analysis (Milestone 3)
STT_PROVIDER=faster_whisper
WHISPER_MODEL=tiny
KEYFRAMES_PER_SCENE=3
ANALYSIS_MAX_DURATION_SECONDS=180
ANALYSIS_QUEUE_NAME=shorts:queue:analysis
