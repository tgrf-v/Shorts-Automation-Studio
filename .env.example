# Application Environment
APP_ENV=development
APP_NAME="Shorts Automation Studio"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=shorts_automation
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_dev@postgres:5432/shorts_automation

# Cache & Queue (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# AI LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Voice / TTS Providers
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GOOGLE_TTS_CREDENTIALS=your_google_tts_credentials_json_or_path

# Media Storage & Upload
MEDIA_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=500

# Cloudflare R2 / S3 Object Storage (Production)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=shorts-automation-assets
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key

# Web / Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
